<nav class="c-docs-toc{{ variant }}">
	{%- set topics = collections.docs | groupby("data.sectionLabel") %}
	{%- set currentPath = _ctx().section | default([]) | join("/") %}
	{#- A split page joins the collection once, at its first url, so every part
		highlights as the whole document does. -#}
	{%- set currentUrl = _pagebreak.parts[0].url if _pagebreak else page.url %}
	{%- for topic, items in topics %}
		{%- set topicSection = items[0].data.section | default([]) %}
		{%- set topicPath = topicSection | join("/") %}
		{%- set topicHref = "/" ~ topicPath ~ "/" %}
		{%- if loop.index0 >= 0 %}
			<div class="c-docs-toc__item {{ "active" if topicPath === currentPath }}" data-section="{{ topicSection[1] }}">
				<div class="c-docs-toc__row">
					<p>
						<strong
							><a
								class="c-docs-toc__link"
								href="{{ topicHref }}"
								{%- if currentUrl === topicHref %}aria-current="page"{%- endif %}
								>{{ topic }}</a
							></strong
						>
					</p>
					{% if items.length > 1 %}
						<button class="c-docs-toc__menu__caret" aria-expanded="false" aria-label="Toggle Concepts">
							<svg width="16" height="16" fill="currentColor" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 640 640">
								<!--!Font Awesome Free v7.2.0 by @fontawesome - https://fontawesome.com License - https://fontawesome.com/license/free Copyright 2026 Fonticons, Inc.-->
								<path
									d="M297.4 438.6C309.9 451.1 330.2 451.1 342.7 438.6L502.7 278.6C515.2 266.1 515.2 245.8 502.7 233.3C490.2 220.8 469.9 220.8 457.4 233.3L320 370.7L182.6 233.4C170.1 220.9 149.8 220.9 137.3 233.4C124.8 245.9 124.8 266.2 137.3 278.7L297.3 438.7z"
								/>
							</svg>
						</button>
					{% endif %}
				</div>
			</div>
			{% if items.length > 1 %}
				<div class="c-docs-toc__children" hidden="true">
					<ul class="c-docs-toc__block">
						{%- for item in items %}
							{%- if item.page.fileSlug !== "00.index" %}
								<li>
									<a
										class="c-docs-toc__link"
										href="{{ item.page.url }}"
										{%- if currentUrl === item.page.url %}aria-current="page"{%- endif %}
										>{{ item.data.title }}</a
									>
								</li>
							{%- endif %}
						{%- endfor %}
					</ul>
				</div>
			{% endif %}
			{%- if not variant %}
				<hr />
			{%- endif %}
		{%- endif %}
	{%- endfor %}
</nav>
