<div class="c-lang-switcher">
	<div class="c-lang-switcher__inner">
		{# page.translations lists siblings only, so the current language is added back
		here. Iterating settings.languages keeps the order the config declares. #}
		{% if page.translationKey %}
			{% for lang, config in settings.languages %}
				{% if lang == page.lang %}
					<a
						lang="{{ lang }}"
						hreflang="{{ lang }}"
						href="{{ page.url }}"
						aria-current="page"
						class="c-lang-switcher__item"
						>{{ config.languageName }}</a
					>
				{% else %}
					{% for entry in page.translations %}
						{% if entry.lang == lang %}
							<a
								lang="{{ entry.lang }}"
								hreflang="{{ entry.lang }}"
								href="{{ entry.url }}"
								class="c-lang-switcher__item"
								>{{ entry.label }}</a
							>
						{% endif %}
					{% endfor %}
				{% endif %}
			{% endfor %}
		{% else %}
			{# Untranslated page: offer the homepages instead. Still reads the collection
			because there is no by-key lookup on the graph index yet. #}
			{% set homepages = collections.translationsMap.homepage %}
			{% for lang, config in settings.languages %}
				{% if homepages[lang] %}
					<a lang="{{ lang }}" hreflang="{{ lang }}" href="{{ homepages[lang].url }}" class="c-lang-switcher__item"
						>{{ config.languageName }}</a
					>
				{% endif %}
			{% endfor %}
		{% endif %}
	</div>
</div>
